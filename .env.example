# Dirección base de api-directorio-comercios.
# Desde el teléfono usar la IP de la computadora en la misma wifi (no localhost),
# o la URL https de la API publicada para el APK de EAS.
EXPO_PUBLIC_API_URL=https://api-dm-five.vercel.app
# Clave de Google Maps SDK for Android, restringida por package y certificado SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
# ID real del proyecto EAS, necesario para avisos push con la app cerrada.
EAS_PROJECT_ID=
